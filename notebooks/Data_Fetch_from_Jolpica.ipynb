# ═══════════════════════════════════════════════════════════════════════
# F1 STATS GUY — DATA UPDATE AGENT (Approach B: current-season refresh)
# Self-contained. Run weekly after each race.
# Re-fetches the current season's completed races and OVERWRITES them.
# Safe to run any number of times (idempotent).
# ═══════════════════════════════════════════════════════════════════════

# ── INSTALL + MOUNT ───────────────────────────────────────────────────
import subprocess
subprocess.run(["pip", "install", "requests", "-q"])

from google.colab import drive
drive.mount("/content/drive")

import requests
import csv
import time
import os
from datetime import datetime, timezone

# ── CONFIG ────────────────────────────────────────────────────────────
BASE   = "https://api.jolpi.ca/f1/alpha"
FOLDER = "/content/drive/MyDrive/F1 Stats Guy - Jolpica/Jolpica Database"
SLEEP  = 0.5

# ── FILE PATHS ────────────────────────────────────────────────────────
F_ROUNDS      = f"{FOLDER}/rounds.csv"
F_RACE        = f"{FOLDER}/race_results.csv"
F_QUALI       = f"{FOLDER}/qualifying_results.csv"
F_SPRINT_R    = f"{FOLDER}/sprint_results.csv"
F_SPRINT_Q    = f"{FOLDER}/sprint_qualifying_results.csv"
F_DRIVERS     = f"{FOLDER}/drivers.csv"
F_TEAMS       = f"{FOLDER}/teams.csv"
F_LOG         = f"{FOLDER}/download_log.csv"
F_LAST_REFRESH= f"{FOLDER}/last_refresh.txt"

# ── HEADERS ───────────────────────────────────────────────────────────
H_ROUNDS   = ["round_id","year","round_number","round_name",
              "circuit_id","circuit_name","circuit_reference",
              "country_code","locality","race_date","has_sprint"]
H_RACE     = ["round_id","driver_id","driver_name","team_id",
              "team_name","car_number","position","position_text",
              "is_classified","points","status","grid"]
H_QUALI    = ["round_id","driver_id","driver_name","team_id",
              "team_name","car_number","position",
              "q1_time","q2_time","q3_time"]
H_SPRINT_R = H_RACE
H_SPRINT_Q = ["round_id","driver_id","driver_name","team_id",
              "team_name","car_number","position",
              "sq1_time","sq2_time","sq3_time"]
H_DRIVERS  = ["driver_id","abbreviation","given_name","family_name"]
H_TEAMS    = ["team_id","team_name","primary_color"]
H_LOG      = ["round_id","year","round_number","round_name",
              "r_status","q_status","sr_status","sq_status"]

# ── CSV HELPERS ───────────────────────────────────────────────────────
def append_csv(filepath, rows, headers):
    if not rows:
        return
    with open(filepath, "a", newline="", encoding="utf-8") as f:
        csv.DictWriter(f, fieldnames=headers).writerows(rows)

def rewrite_csv(filepath, headers, rows):
    """Atomic full rewrite: write temp, then replace."""
    tmp = filepath + ".tmp"
    with open(tmp, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=headers)
        w.writeheader()
        w.writerows(rows)
    os.replace(tmp, filepath)

def overwrite_rounds_in_csv(filepath, headers, refresh_ids, new_rows):
    """Drop rows whose round_id is in refresh_ids, append new_rows, atomic rewrite."""
    kept = []
    if os.path.exists(filepath):
        with open(filepath, newline="", encoding="utf-8") as f:
            for row in csv.DictReader(f):
                if row.get("round_id") not in refresh_ids:
                    kept.append(row)
    kept.extend(new_rows)
    rewrite_csv(filepath, headers, kept)

# ── REFERENCE TRACKING (load existing IDs to avoid dupes) ──────────────
seen_drivers = set()
seen_teams   = set()
if os.path.exists(F_DRIVERS):
    with open(F_DRIVERS, encoding="utf-8") as f:
        for row in csv.DictReader(f):
            seen_drivers.add(row["driver_id"])
if os.path.exists(F_TEAMS):
    with open(F_TEAMS, encoding="utf-8") as f:
        for row in csv.DictReader(f):
            seen_teams.add(row["team_id"])

# ── API + PARSERS ─────────────────────────────────────────────────────
def safe_get(url, retries=3):
    for _ in range(retries):
        try:
            r = requests.get(url, timeout=15)
            if r.status_code == 200:
                return r.json()
            elif r.status_code == 404:
                return None
        except Exception as e:
            print(f"  ⚠ Error: {e}")
        time.sleep(2)
    return None

def track_driver_and_team(driver, team, driver_rows, team_rows):
    did, tid = driver.get("id",""), team.get("id","")
    if did and did not in seen_drivers:
        seen_drivers.add(did)
        driver_rows.append({
            "driver_id": did,
            "abbreviation": driver.get("abbreviation",""),
            "given_name": driver.get("given_name",""),
            "family_name": driver.get("family_name",""),
        })
    if tid and tid not in seen_teams:
        seen_teams.add(tid)
        team_rows.append({
            "team_id": tid,
            "team_name": team.get("name",""),
            "primary_color": team.get("primary_color",""),
        })

def parse_race(round_id, data, driver_rows, team_rows):
    rows = []
    if not data or "data" not in data:
        return rows
    for r in data["data"].get("results", []):
        driver, team = r.get("driver",{}), r.get("team",{})
        track_driver_and_team(driver, team, driver_rows, team_rows)
        rows.append({
            "round_id": round_id,
            "driver_id": driver.get("id",""),
            "driver_name": f"{driver.get('given_name','')} {driver.get('family_name','')}".strip(),
            "team_id": team.get("id",""),
            "team_name": team.get("name",""),
            "car_number": r.get("car_number",""),
            "position": r.get("position",""),
            "position_text": r.get("position_text",""),
            "is_classified": r.get("is_classified",""),
            "points": r.get("points",""),
            "status": r.get("status",""),
            "grid": r.get("grid",""),
        })
    return rows

def parse_quali(round_id, data, driver_rows, team_rows):
    rows = []
    if not data or "data" not in data:
        return rows
    for r in data["data"].get("results", []):
        driver, team = r.get("driver",{}), r.get("team",{})
        comps = r.get("components",{})
        track_driver_and_team(driver, team, driver_rows, team_rows)
        rows.append({
            "round_id": round_id,
            "driver_id": driver.get("id",""),
            "driver_name": f"{driver.get('given_name','')} {driver.get('family_name','')}".strip(),
            "team_id": team.get("id",""),
            "team_name": team.get("name",""),
            "car_number": r.get("car_number",""),
            "position": r.get("position",""),
            "q1_time": comps.get("Q1",{}).get("time",""),
            "q2_time": comps.get("Q2",{}).get("time",""),
            "q3_time": comps.get("Q3",{}).get("time",""),
        })
    return rows

def parse_sprint_quali(round_id, data, driver_rows, team_rows):
    rows = []
    if not data or "data" not in data:
        return rows
    for r in data["data"].get("results", []):
        driver, team = r.get("driver",{}), r.get("team",{})
        comps = r.get("components",{})
        track_driver_and_team(driver, team, driver_rows, team_rows)
        rows.append({
            "round_id": round_id,
            "driver_id": driver.get("id",""),
            "driver_name": f"{driver.get('given_name','')} {driver.get('family_name','')}".strip(),
            "team_id": team.get("id",""),
            "team_name": team.get("name",""),
            "car_number": r.get("car_number",""),
            "position": r.get("position",""),
            "sq1_time": comps.get("SQ1",{}).get("time",""),
            "sq2_time": comps.get("SQ2",{}).get("time",""),
            "sq3_time": comps.get("SQ3",{}).get("time",""),
        })
    return rows

# ═══════════════════════════════════════════════════════════════════════
# STEP 1 — Re-fetch full round index, overwrite rounds.csv
# ═══════════════════════════════════════════════════════════════════════
print("═"*60); print("STEP 1 — Refreshing round index"); print("═"*60)

all_rounds, page = [], 1
while True:
    data = safe_get(f"{BASE}/core/rounds/?page={page}")
    time.sleep(SLEEP)
    if not data or "data" not in data:
        print(f"  ⚠ No data on page {page} — stopping"); break
    total_pages = data["metadata"]["total_pages"]
    for rnd in data["data"]:
        session_types = [s["type"] for s in rnd.get("sessions", [])]
        has_sprint = "SR" in session_types or "SQ" in session_types
        circuit = rnd.get("circuit", {})
        race_date = ""
        for s in rnd.get("sessions", []):
            if s["type"] == "R":
                race_date = s.get("timestamp","")[:10]; break
        all_rounds.append({
            "round_id": rnd["id"], "year": rnd["season"]["year"],
            "round_number": rnd["number"], "round_name": rnd["name"],
            "circuit_id": circuit.get("id",""), "circuit_name": circuit.get("name",""),
            "circuit_reference": circuit.get("reference",""),
            "country_code": circuit.get("country_code",""),
            "locality": circuit.get("locality",""),
            "race_date": race_date, "has_sprint": has_sprint,
        })
    print(f"  Page {page}/{total_pages} — {len(data['data'])} rounds")
    if page >= total_pages: break
    page += 1

rewrite_csv(F_ROUNDS, H_ROUNDS, all_rounds)
print(f"✅ rounds.csv refreshed: {len(all_rounds)} rounds")

# ═══════════════════════════════════════════════════════════════════════
# STEP 2 — Build refresh set: current season, completed races only
# ═══════════════════════════════════════════════════════════════════════
today = datetime.now(timezone.utc).date().isoformat()
CURRENT_SEASON = max(r["year"] for r in all_rounds)

refresh_rounds = [
    r for r in all_rounds
    if r["year"] == CURRENT_SEASON
    and r["race_date"]            # non-empty
    and r["race_date"] <= today   # already happened
]
refresh_ids = {r["round_id"] for r in refresh_rounds}

print(f"\nCurrent season: {CURRENT_SEASON}  |  Today (UTC): {today}")
print(f"Races to refresh: {len(refresh_rounds)}")

if not refresh_rounds:
    print("Nothing to refresh. Writing timestamp and exiting.")
    with open(F_LAST_REFRESH, "w") as f:
        f.write(datetime.now(timezone.utc).isoformat())
else:
    # ═══════════════════════════════════════════════════════════════════
    # STEP 3 — Fetch ALL fresh data into memory (network-break safe)
    # ═══════════════════════════════════════════════════════════════════
    print(f"\n{'═'*60}"); print("STEP 3 — Fetching fresh results"); print("═"*60)

    new_race, new_quali, new_sr, new_sq = [], [], [], []
    new_drivers, new_teams, new_logs = [], [], []

    for r in sorted(refresh_rounds, key=lambda x: x["round_number"]):
        rid, rnum, rname = r["round_id"], r["round_number"], r["round_name"]
        has_sprint = r["has_sprint"]
        print(f"  R{rnum} — {rname}")

        log = {"round_id": rid, "year": r["year"], "round_number": rnum,
               "round_name": rname, "r_status": "", "q_status": "",
               "sr_status": "SKIP", "sq_status": "SKIP"}

        r_data = safe_get(f"{BASE}/results/{rid}/R/"); time.sleep(SLEEP)
        rr = parse_race(rid, r_data, new_drivers, new_teams) if r_data else []
        new_race.extend(rr); log["r_status"] = f"OK:{len(rr)}" if r_data else "EMPTY"

        q_data = safe_get(f"{BASE}/results/{rid}/Q/"); time.sleep(SLEEP)
        qq = parse_quali(rid, q_data, new_drivers, new_teams) if q_data else []
        new_quali.extend(qq); log["q_status"] = f"OK:{len(qq)}" if q_data else "EMPTY"

        if has_sprint:
            sr_data = safe_get(f"{BASE}/results/{rid}/SR/"); time.sleep(SLEEP)
            sr = parse_race(rid, sr_data, new_drivers, new_teams) if sr_data else []
            new_sr.extend(sr); log["sr_status"] = f"OK:{len(sr)}" if sr_data else "EMPTY"

            sq_data = safe_get(f"{BASE}/results/{rid}/SQ/"); time.sleep(SLEEP)
            sq = parse_sprint_quali(rid, sq_data, new_drivers, new_teams) if sq_data else []
            new_sq.extend(sq); log["sq_status"] = f"OK:{len(sq)}" if sq_data else "EMPTY"

        new_logs.append(log)

    # ═══════════════════════════════════════════════════════════════════
    # STEP 4 — Overwrite refreshed rounds in all CSVs (atomic)
    # ═══════════════════════════════════════════════════════════════════
    print(f"\n{'═'*60}"); print("STEP 4 — Writing (overwrite mode)"); print("═"*60)

    overwrite_rounds_in_csv(F_RACE,     H_RACE,     refresh_ids, new_race)
    overwrite_rounds_in_csv(F_QUALI,    H_QUALI,    refresh_ids, new_quali)
    overwrite_rounds_in_csv(F_SPRINT_R, H_SPRINT_R, refresh_ids, new_sr)
    overwrite_rounds_in_csv(F_SPRINT_Q, H_SPRINT_Q, refresh_ids, new_sq)
    overwrite_rounds_in_csv(F_LOG,      H_LOG,      refresh_ids, new_logs)

    # drivers/teams stay append-only (new rookies etc.)
    append_csv(F_DRIVERS, new_drivers, H_DRIVERS)
    append_csv(F_TEAMS,   new_teams,   H_TEAMS)

    with open(F_LAST_REFRESH, "w") as f:
        f.write(datetime.now(timezone.utc).isoformat())

    print(f"  Race rows written   : {len(new_race)}")
    print(f"  Quali rows written  : {len(new_quali)}")
    print(f"  Sprint R / Q        : {len(new_sr)} / {len(new_sq)}")
    print(f"  New drivers / teams : {len(new_drivers)} / {len(new_teams)}")
    print(f"  Rounds refreshed    : {len(refresh_ids)}")
    print(f"✅ Update complete.")
